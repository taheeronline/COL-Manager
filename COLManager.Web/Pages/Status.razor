@page "/status"
@inject COLManager.Web.Services.IStatusService StatusService
@inject Microsoft.JSInterop.IJSRuntime JS

<h3>Statuses</h3>

<button class="btn btn-primary" @onclick="BeginCreate"><i class="bi bi-plus-circle"></i> New Status</button>

@if (!string.IsNullOrEmpty(Message))
{
    <div class="alert alert-info alert-dismissible fade show mt-3" role="alert">
        @Message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (IsLoading)
{
    <p class="mt-3"><span class="spinner-border spinner-border-sm me-2"></span>Loading statuses...</p>
}
else if (StatusList == null || !StatusList.Any())
{
    <div class="alert alert-warning mt-3">
        No statuses found. <a href="#" @onclick="BeginCreate" @onclick:preventDefault>Create one now</a>.
    </div>
}
else
{
    <table class="table table-striped table-hover mt-3">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in StatusList)
            {
                <tr>
                    <td>@s.StatusID</td>
                    <td><strong>@s.StatusName</strong></td>
                    <td>
                        <button class="btn btn-sm btn-info me-1" @onclick="() => Edit(s.StatusID)" title="Edit">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button class="btn btn-sm btn-danger" @onclick="() => ConfirmDelete(s.StatusID)" title="Delete">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (Editing)
{
    <div class="modal show d-block" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(EditId == 0 ? "Create Status" : "Edit Status")</h5>
                    <button type="button" class="btn-close" @onclick="CancelEdit"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="EditModel" OnValidSubmit="Save">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label">Status Name <span style="color:red;">*</span></label>
                            <InputText @bind-Value="EditModel.StatusName" class="form-control" />
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
                            <button type="submit" class="btn btn-primary">@(EditId == 0 ? "Create" : "Update")</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private IEnumerable<COLManager.Web.Entities.StatusMaster> StatusList = Array.Empty<COLManager.Web.Entities.StatusMaster>();
    private bool IsLoading = true;
    private bool Editing = false;
    private string? Message;
    private int EditId = 0;

    private COLManager.Web.Entities.StatusMaster EditModel = new COLManager.Web.Entities.StatusMaster();

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        IsLoading = true;
        Message = null;
        var res = await StatusService.GetAllAsync();
        if (res.Success)
            StatusList = res.Data ?? Array.Empty<COLManager.Web.Entities.StatusMaster>();
        else
            Message = res.Message ?? "Failed to load statuses.";
        IsLoading = false;
    }

    private void BeginCreate()
    {
        Editing = true;
        EditId = 0;
        EditModel = new COLManager.Web.Entities.StatusMaster();
    }

    private async Task Edit(int id)
    {
        var res = await StatusService.GetByIdAsync(id);
        if (res.Success)
        {
            EditModel = res.Data!;
            EditId = id;
            Editing = true;
        }
        else
            Message = res.Message ?? "Failed to load status.";
    }

    private void CancelEdit()
    {
        Editing = false;
        EditId = 0;
    }

    private async Task Save()
    {
        Message = null;
        if (EditId == 0)
        {
            // Create
            var res = await StatusService.CreateAsync(EditModel);
            if (res.Success)
            {
                Message = res.Message ?? "Status created successfully.";
                Editing = false;
                await Load();
            }
            else
                Message = res.Message ?? "Failed to create status.";
        }
        else
        {
            // Update
            var res = await StatusService.UpdateAsync(EditModel);
            if (res.Success)
            {
                Message = res.Message ?? "Status updated successfully.";
                Editing = false;
                EditId = 0;
                await Load();
            }
            else
                Message = res.Message ?? "Failed to update status.";
        }
    }

    private async Task ConfirmDelete(int id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirmAction", "Delete this status? This action cannot be undone.");
        if (!confirmed) return;

        var res = await StatusService.DeleteAsync(id);
        if (res.Success)
        {
            await JS.InvokeVoidAsync("showToast", res.Message ?? "Status deleted.");
            await Load();
        }
        else
        {
            await JS.InvokeVoidAsync("showToast", res.Message ?? "Failed to delete status.");
        }
    }
}