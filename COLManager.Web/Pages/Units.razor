@page "/units"
@inject COLManager.Web.Services.IUnitService UnitService
@inject COLManager.Web.Services.IMeasurementService MeasurementService
@inject Microsoft.JSInterop.IJSRuntime JS

<h3>Units</h3>

<button class="btn btn-primary" @onclick="BeginCreate"><i class="bi bi-plus-circle"></i> New Unit</button>

@if (!string.IsNullOrEmpty(Message))
{
    <div class="alert alert-info alert-dismissible fade show mt-3" role="alert">
        @Message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (IsLoading)
{
    <p class="mt-3"><span class="spinner-border spinner-border-sm me-2"></span>Loading units...</p>
}
else if (UnitList == null || !UnitList.Any())
{
    <div class="alert alert-warning mt-3">
        No units found. <a href="#" @onclick="BeginCreate" @onclick:preventDefault>Create one now</a>.
    </div>
}
else
{
    <table class="table table-striped table-hover mt-3">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Symbol</th>
                <th>Measurement Type</th>
                <th>Base Unit</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in UnitList)
            {
                <tr>
                    <td>@u.UnitID</td>
                    <td><strong>@u.UnitName</strong></td>
                    <td><code>@u.UnitSymbol</code></td>
                    <td>@GetMeasurementName(u.MeasurementTypeID)</td>
                    <td>
                        <span class="badge @(u.IsBaseUnit ? "bg-success" : "bg-secondary")">
                            @(u.IsBaseUnit ? "Yes" : "No")
                        </span>
                    </td>
                    <td>
                        <button class="btn btn-sm btn-info me-1" @onclick="() => Edit(u.UnitID)" title="Edit">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button class="btn btn-sm btn-danger" @onclick="() => ConfirmDelete(u.UnitID)" title="Delete">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (Editing)
{
    <div class="modal show d-block" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(EditId == 0 ? "Create Unit" : "Edit Unit")</h5>
                    <button type="button" class="btn-close" @onclick="CancelEdit"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="EditModel" OnValidSubmit="Save">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label">Unit Name <span style="color:red;">*</span></label>
                            <InputText @bind-Value="EditModel.UnitName" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Unit Symbol <span style="color:red;">*</span></label>
                            <InputText @bind-Value="EditModel.UnitSymbol" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Measurement Type <span style="color:red;">*</span></label>
                            <InputSelect @bind-Value="EditModel.MeasurementTypeID" class="form-select">
                                <option value="0">-- Select Measurement Type --</option>
                                @foreach (var m in Measurements)
                                {
                                    <option value="@m.MeasurementTypeID">@m.MeasurementName</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="mb-3 form-check">
                            <InputCheckbox @bind-Value="EditModel.IsBaseUnit" class="form-check-input" id="isBaseUnit" />
                            <label class="form-check-label" for="isBaseUnit">Is Base Unit</label>
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
                            <button type="submit" class="btn btn-primary">@(EditId == 0 ? "Create" : "Update")</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private IEnumerable<COLManager.Web.Entities.UnitMaster> UnitList = Array.Empty<COLManager.Web.Entities.UnitMaster>();
    private IEnumerable<COLManager.Web.Entities.MeasurementType> Measurements = Array.Empty<COLManager.Web.Entities.MeasurementType>();
    private bool IsLoading = true;
    private bool Editing = false;
    private string? Message;
    private int EditId = 0;

    private COLManager.Web.Entities.UnitMaster EditModel = new COLManager.Web.Entities.UnitMaster();

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        IsLoading = true;
        Message = null;

        var mres = await MeasurementService.GetAllAsync();
        if (mres.Success)
            Measurements = mres.Data ?? Array.Empty<COLManager.Web.Entities.MeasurementType>();

        var res = await UnitService.GetAllAsync();
        if (res.Success)
            UnitList = res.Data ?? Array.Empty<COLManager.Web.Entities.UnitMaster>();
        else
            Message = res.Message ?? "Failed to load units.";
        IsLoading = false;
    }

    private string GetMeasurementName(int id)
    {
        var m = Measurements.FirstOrDefault(x => x.MeasurementTypeID == id);
        return m?.MeasurementName ?? $"Measurement {id}";
    }

    private void BeginCreate()
    {
        if (Measurements == null || !Measurements.Any())
        {
            Message = "Please create at least one measurement type first.";
            return;
        }
        Editing = true;
        EditId = 0;
        EditModel = new COLManager.Web.Entities.UnitMaster();
    }

    private async Task Edit(int id)
    {
        var res = await UnitService.GetByIdAsync(id);
        if (res.Success)
        {
            EditModel = res.Data!;
            EditId = id;
            Editing = true;
        }
        else
            Message = res.Message ?? "Failed to load unit.";
    }

    private void CancelEdit()
    {
        Editing = false;
        EditId = 0;
    }

    private async Task Save()
    {
        Message = null;
        if (EditId == 0)
        {
            // Create
            var res = await UnitService.CreateAsync(EditModel);
            if (res.Success)
            {
                Message = res.Message ?? "Unit created successfully.";
                Editing = false;
                await Load();
            }
            else
                Message = res.Message ?? "Failed to create unit.";
        }
        else
        {
            // Update
            var res = await UnitService.UpdateAsync(EditModel);
            if (res.Success)
            {
                Message = res.Message ?? "Unit updated successfully.";
                Editing = false;
                EditId = 0;
                await Load();
            }
            else
                Message = res.Message ?? "Failed to update unit.";
        }
    }

    private async Task ConfirmDelete(int id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirmAction", "Delete this unit? This action cannot be undone.");
        if (!confirmed) return;

        var res = await UnitService.DeleteAsync(id);
        if (res.Success)
        {
            await JS.InvokeVoidAsync("showToast", res.Message ?? "Unit deleted.");
            await Load();
        }
        else
        {
            await JS.InvokeVoidAsync("showToast", res.Message ?? "Failed to delete unit.");
        }
    }
}