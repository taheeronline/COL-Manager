@page "/usage"
@inject COLManager.Web.Services.IUsageService UsageService
@inject COLManager.Web.Services.IColumnService ColumnService
@inject Microsoft.JSInterop.IJSRuntime JS

<h3>Usage Logs</h3>

<button class="btn btn-primary" @onclick="BeginCreate"><i class="bi bi-plus-circle"></i> New Usage</button>

@if (!string.IsNullOrEmpty(Message))
{
    <div class="alert alert-info alert-dismissible fade show mt-3" role="alert">
        @Message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (IsLoading)
{
    <p class="mt-3"><span class="spinner-border spinner-border-sm me-2"></span>Loading usage logs...</p>
}
else if (UsageList == null || !UsageList.Any())
{
    <div class="alert alert-warning mt-3">
        No usage logs found. <a href="#" @onclick="BeginCreate" @onclick:preventDefault>Create one now</a>.
    </div>
}
else
{
    <table class="table table-striped table-hover mt-3">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Column</th>
                <th>Serial</th>
                <th>Runtime (h)</th>
                <th>Injections</th>
                <th>Pre Pressure (bar)</th>
                <th>Post Pressure (bar)</th>
                <th>Max Pressure (bar)</th>
                <th>Run Date</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in UsageList)
            {
                <tr>
                    <td>@u.UsageID</td>
                    <td><strong>@GetColumnName(u.ColumnID)</strong></td>
                    <td><code>@GetColumnSerial(u.ColumnID)</code></td>
                    <td>@u.RuntimeHours</td>
                    <td>@u.NumberOfInjections</td>
                    <td>@u.PreUseBackPressureBar</td>
                    <td>@u.PostUseBackPressureBar</td>
                    <td>@u.MaxPressureObservedBar</td>
                    <td>@u.RunDate.ToString("yyyy-MM-dd")</td>
                    <td>
                        <button class="btn btn-sm btn-danger" @onclick="() => ConfirmDelete(u.UsageID)" title="Delete">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (Editing)
{
    <div class="modal show d-block" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Log New Usage</h5>
                    <button type="button" class="btn-close" @onclick="CancelEdit"></button>
                </div>
                <div class="modal-body">
                    @if (Columns == null || !Columns.Any())
                    {
                        <div class="alert alert-warning">
                            <strong>No columns available.</strong> Please create a column first. <a href="/columns" target="_blank">Go to Columns page</a>.
                        </div>
                    }
                    else
                    {
                        <EditForm Model="EditModel" OnValidSubmit="Save">
                            <DataAnnotationsValidator />
                            <ValidationSummary />
                            
                            <div class="mb-3">
                                <label class="form-label">Column <span style="color:red;">*</span></label>
                                <InputSelect @bind-Value="EditModel.ColumnID" class="form-select">
                                    <option value="0">-- Select Column --</option>
                                    @foreach (var c in Columns)
                                    {
                                        <option value="@c.ColumnID">@c.ColumnName (@c.SerialNumber)</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Runtime Hours <span style="color:red;">*</span></label>
                                    <InputNumber @bind-Value="EditModel.RuntimeHours" class="form-control" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Number of Injections <span style="color:red;">*</span></label>
                                    <InputNumber @bind-Value="EditModel.NumberOfInjections" class="form-control" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Pre-Use Back Pressure (bar) <span style="color:red;">*</span></label>
                                    <InputNumber @bind-Value="EditModel.PreUseBackPressureBar" class="form-control" step="0.01" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Post-Use Back Pressure (bar) <span style="color:red;">*</span></label>
                                    <InputNumber @bind-Value="EditModel.PostUseBackPressureBar" class="form-control" step="0.01" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Max Pressure Observed (bar) <span style="color:red;">*</span></label>
                                    <InputNumber @bind-Value="EditModel.MaxPressureObservedBar" class="form-control" step="0.01" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Flow Rate (mL/min)</label>
                                    <InputNumber @bind-Value="EditModel.FlowRateMLPerMin" class="form-control" step="0.001" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Injection Volume (mL)</label>
                                    <InputNumber @bind-Value="EditModel.InjectionVolumeML" class="form-control" step="0.0001" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Run Date <span style="color:red;">*</span></label>
                                    <InputDate @bind-Value="EditModel.RunDate" class="form-control" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Remarks</label>
                                <InputTextArea @bind-Value="EditModel.Remarks" class="form-control" rows="3" placeholder="Optional notes about this usage..." />
                            </div>

                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
                                <button type="submit" class="btn btn-primary">Log Usage</button>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private IEnumerable<COLManager.Web.DTOs.ColumnUsageReadDto> UsageList = Array.Empty<COLManager.Web.DTOs.ColumnUsageReadDto>();
    private IEnumerable<COLManager.Web.DTOs.ColumnMasterReadDto> Columns = Array.Empty<COLManager.Web.DTOs.ColumnMasterReadDto>();
    private bool IsLoading = true;
    private bool Editing = false;
    private string? Message;

    private COLManager.Web.DTOs.ColumnUsageCreateDto EditModel = new COLManager.Web.DTOs.ColumnUsageCreateDto();

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        IsLoading = true;
        Message = null;

        // Load columns
        var colRes = await ColumnService.GetAllAsync();
        if (colRes.Success)
            Columns = colRes.Data ?? Array.Empty<COLManager.Web.DTOs.ColumnMasterReadDto>();

        // Load usage logs
        var res = await UsageService.GetAllAsync();
        if (res.Success)
            UsageList = res.Data ?? Array.Empty<COLManager.Web.DTOs.ColumnUsageReadDto>();
        else
            Message = res.Message ?? "Failed to load usage logs.";
        IsLoading = false;
    }

    private string GetColumnName(int columnId)
    {
        var c = Columns.FirstOrDefault(x => x.ColumnID == columnId);
        return c?.ColumnName ?? $"Column {columnId}";
    }

    private string GetColumnSerial(int columnId)
    {
        var c = Columns.FirstOrDefault(x => x.ColumnID == columnId);
        return c?.SerialNumber ?? "";
    }

    private void BeginCreate()
    {
        if (Columns == null || !Columns.Any())
        {
            Message = "Please create at least one column before logging usage.";
            return;
        }
        Editing = true;
        EditModel = new COLManager.Web.DTOs.ColumnUsageCreateDto { RunDate = DateTime.Now };
    }

    private void CancelEdit()
    {
        Editing = false;
    }

    private async Task Save()
    {
        Message = null;
        var res = await UsageService.CreateAsync(EditModel);
        if (res.Success)
        {
            Message = res.Message ?? "Usage logged successfully.";
            Editing = false;
            await Load();
        }
        else
            Message = res.Message ?? "Failed to log usage.";
    }

    private async Task ConfirmDelete(int id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirmAction", "Delete this usage log? This action cannot be undone.");
        if (!confirmed) return;

        var res = await UsageService.DeleteAsync(id);
        if (res.Success)
        {
            await JS.InvokeVoidAsync("showToast", res.Message ?? "Usage log deleted.");
            await Load();
        }
        else
        {
            await JS.InvokeVoidAsync("showToast", res.Message ?? "Failed to delete usage log.");
        }
    }
}
