@page "/checkin"
@using COLManager.Web.DTOs
@using COLManager.Web.Enums
@inject IUsageService UsageService
@inject IJSRuntime JSRuntime

<h3>Column Check-in</h3>

@if (!CheckoutList.Any())
{
    <div class="alert alert-warning">No checked-out columns.</div>
}
else
{
    <table class="table table-striped">
        <thead class="table-dark">
            <tr>
                <th>Column</th>
                <th>Protocol</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in CheckoutList)
            {
                <tr>
                    <td>
                        <strong>@c.ColumnName</strong><br />
                        <small class="text-muted">@c.SerialNumber</small>
                    </td>
                    <td>@c.ProtocolName</td>
                    <td><span class="badge bg-danger">Checked Out</span></td>
                    <td>
                        <button class="btn btn-sm btn-primary"
                                @onclick="() => BeginCheckin(c)">
                            Check-in
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (IsCheckin)
{
    <div class="modal show d-block" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-lg" @onclick:stopPropagation>
            <div class="modal-content">

                <div class="modal-header">
                    <h5>Check-in Column</h5>
                    <button class="btn-close" @onclick="CancelCheckin"></button>
                </div>

                <div class="modal-body">

                    <div class="alert alert-info">
                        <strong>@SelectedItem?.ColumnName</strong>
                        (@SelectedItem?.SerialNumber)<br />
                        Protocol: <strong>@SelectedItem?.ProtocolName</strong>
                    </div>

                    <EditForm Model="CheckinModel" OnValidSubmit="SaveCheckin">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label>Runtime Hours *</label>
                                <InputNumber @bind-Value="CheckinModel.RuntimeHours"
                                             class="form-control"
                                             @oninput="EvaluateLimits" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label>Injections *</label>
                                <InputNumber @bind-Value="CheckinModel.NumberOfInjections"
                                             class="form-control"
                                             @oninput="EvaluateLimits" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label>Pre Pressure *</label>
                                <InputNumber @bind-Value="CheckinModel.PreUseBackPressureBar"
                                             class="form-control"
                                             @oninput="EvaluateLimits" />
                            </div>

                            <div class="col-md-4 mb-3">
                                <label>Post Pressure *</label>
                                <InputNumber @bind-Value="CheckinModel.PostUseBackPressureBar"
                                             class="form-control"
                                             @oninput="EvaluateLimits" />
                            </div>

                            <div class="col-md-4 mb-3">
                                <label>Max Pressure *</label>
                                <InputNumber @bind-Value="CheckinModel.MaxPressureObservedBar"
                                             class="form-control"
                                             @oninput="EvaluateLimits" />
                            </div>
                        </div>

                        @if (SelectedItem != null)
                        {
                            <div class="alert @(IsExceeded ? "alert-danger" : IsWarning ? "alert-warning" : "alert-success")">

                                <b>Protocol Limits</b><br />
                                Pressure: @CurrentPressure / @SelectedItem.MaxAllowedPressureBar<br />
                                Hours: @CurrentHours / @SelectedItem.MaxAllowedUsageHours<br />
                                Injections: @CurrentInjections / @SelectedItem.MaxAllowedInjections<br />

                                <br />

                                <b>Column Safety</b><br />
                                <b>Column Max Pressure:</b> @SelectedItem.ColumnMaxPressureBar bar<br />
                                <b>Observed:</b> @CheckinModel.MaxPressureObservedBar bar

                                <div class="mt-2"><strong>@StatusMessage</strong></div>
                            </div>
                        }

                        <div class="mb-3">
                            <label>Remarks</label>
                            <InputTextArea @bind-Value="CheckinModel.Remarks"
                                           class="form-control"
                                           rows="3" />
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CancelCheckin">
                                Cancel
                            </button>

                            <button type="submit" class="btn btn-success">
                                Complete Check-in
                            </button>
                        </div>

                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ColumnCheckoutReadDto> CheckoutList = new();

    private bool IsCheckin;
    private ColumnCheckoutReadDto? SelectedItem;
    private ColumnCheckinDto CheckinModel = new();

    private decimal CurrentPressure;
    private decimal CurrentHours;
    private int CurrentInjections;

    private bool IsExceeded;
    private bool IsWarning;
    private string StatusMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        CheckoutList = await UsageService.GetCheckedOutOnlyAsync();
    }

    private void BeginCheckin(ColumnCheckoutReadDto item)
    {
        SelectedItem = item;
        IsCheckin = true;

        CheckinModel = new ColumnCheckinDto
        {
            CheckoutID = item.CheckoutID
        };

        EvaluateLimits();
    }

    private void CancelCheckin()
    {
        IsCheckin = false;
        SelectedItem = null;
    }

    private void EvaluateLimits()
    {
        if (SelectedItem == null) return;

        CurrentPressure = SelectedItem.TotalPressureUsed + CheckinModel.MaxPressureObservedBar;
        CurrentHours = SelectedItem.TotalRuntimeHours + CheckinModel.RuntimeHours;
        CurrentInjections = SelectedItem.TotalInjections + CheckinModel.NumberOfInjections;

        bool protocolExceeded =
            CurrentPressure > SelectedItem.MaxAllowedPressureBar ||
            CurrentHours > SelectedItem.MaxAllowedUsageHours ||
            CurrentInjections > SelectedItem.MaxAllowedInjections;

        bool columnExceeded =
            CheckinModel.MaxPressureObservedBar > SelectedItem.ColumnMaxPressureBar;

        IsExceeded = protocolExceeded || columnExceeded;

        IsWarning = !IsExceeded &&
            (CurrentPressure > SelectedItem.MaxAllowedPressureBar * 0.8m ||
             CurrentHours > SelectedItem.MaxAllowedUsageHours * 0.8m ||
             CurrentInjections > SelectedItem.MaxAllowedInjections * 0.8m);

        if (columnExceeded)
            StatusMessage = "❌ Column damaged (pressure exceeded)";
        else if (protocolExceeded)
            StatusMessage = "❌ Protocol limits exceeded";
        else if (IsWarning)
            StatusMessage = "⚠ Approaching limits";
        else
            StatusMessage = "✅ Safe";
    }

    private async Task SaveCheckin()
    {
        EvaluateLimits();

        // 🔥 AUTO STATUS DECISION
        if (IsExceeded)
        {
            CheckinModel.Status = ColumnStatus.Retired;

            var confirm = await JSRuntime.InvokeAsync<bool>(
                "confirm",
                "Limits exceeded. Column will be RETIRED. Continue?"
            );

            if (!confirm) return;
        }
        else if (IsWarning)
        {
            CheckinModel.Status = ColumnStatus.UnderMaintenance;

            var confirm = await JSRuntime.InvokeAsync<bool>(
                "confirm",
                "Approaching limits. Mark as UNDER MAINTENANCE?"
            );

            if (!confirm)
                CheckinModel.Status = ColumnStatus.Available;
        }
        else
        {
            CheckinModel.Status = ColumnStatus.Available;
        }

        var result = await UsageService.CheckinAsync(CheckinModel);

        if (result.Success)
        {
            IsCheckin = false;
            SelectedItem = null;
            await LoadData();
        }
    }
}