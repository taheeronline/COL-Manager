@page "/checkin"
@using COLManager.Web.DTOs
@using COLManager.Web.Enums
@inject IUsageService UsageService
@inject IJSRuntime JSRuntime

<h3>Column Check-in</h3>

@if (!string.IsNullOrEmpty(Message))
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        @Message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (IsLoading)
{
    <p><span class="spinner-border spinner-border-sm me-2"></span>Loading checked-out columns...</p>
}
else if (!CheckoutList.Any())
{
    <div class="alert alert-warning">
        No checked-out columns at this time.
    </div>
}
else
{
    <table class="table table-striped table-hover mt-3">
        <thead class="table-dark">
            <tr>
                <th>Column</th>
                <th>Serial Number</th>
                <th>Protocol</th>
                <th>Status</th>
                <th>Checkout Date</th>
                <th>Days Out</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in CheckoutList)
            {
                <tr>
                    <td><strong>@c.ColumnName</strong></td>
                    <td><code>@c.SerialNumber</code></td>
                    <td>@(string.IsNullOrEmpty(c.ProtocolName) || c.ProtocolName == "N/A" ? "-" : c.ProtocolName)</td>
                    <td><span class="badge bg-warning">Checked Out</span></td>
                    <td>@c.CheckoutDate.ToString("yyyy-MM-dd")</td>
                    <td>
                        <span class="badge bg-info">@GetDaysOut(c.CheckoutDate)</span>
                    </td>
                    <td>
                        <button class="btn btn-sm btn-primary"
                                @onclick="() => BeginCheckin(c)">
                            <i class="bi bi-box2-heart"></i> Check-in
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (IsCheckin)
{
    <div class="modal show d-block" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg" @onclick:stopPropagation>
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Check-in Column</h5>
                    <button type="button" class="btn-close" @onclick="CancelCheckin"></button>
                </div>

                <div class="modal-body">
                    <div class="alert alert-info">
                        <strong>@SelectedItem?.ColumnName</strong> (<code>@SelectedItem?.SerialNumber</code>)<br />
                        Protocol: <strong>@(string.IsNullOrEmpty(SelectedItem?.ProtocolName) || SelectedItem?.ProtocolName == "N/A" ? "None" : SelectedItem?.ProtocolName)</strong><br />
                        Checkout Date: <strong>@SelectedItem?.CheckoutDate.ToString("yyyy-MM-dd")</strong>
                    </div>

                    <EditForm Model="CheckinModel" OnValidSubmit="SaveCheckin">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Runtime Hours <span style="color:red;">*</span></label>
                                <InputNumber @bind-Value="CheckinModel.RuntimeHours"
                                             class="form-control"
                                             @oninput="EvaluateLimits" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Injections <span style="color:red;">*</span></label>
                                <InputNumber @bind-Value="CheckinModel.NumberOfInjections"
                                             class="form-control"
                                             @oninput="EvaluateLimits" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Pre Pressure (bar) <span style="color:red;">*</span></label>
                                <InputNumber @bind-Value="CheckinModel.PreUseBackPressureBar"
                                             class="form-control"
                                             @oninput="EvaluateLimits" />
                            </div>

                            <div class="col-md-4 mb-3">
                                <label class="form-label">Post Pressure (bar) <span style="color:red;">*</span></label>
                                <InputNumber @bind-Value="CheckinModel.PostUseBackPressureBar"
                                             class="form-control"
                                             @oninput="EvaluateLimits" />
                            </div>

                            <div class="col-md-4 mb-3">
                                <label class="form-label">Max Pressure (bar) <span style="color:red;">*</span></label>
                                <InputNumber @bind-Value="CheckinModel.MaxPressureObservedBar"
                                             class="form-control"
                                             @oninput="EvaluateLimits" />
                            </div>
                        </div>

                        @if (SelectedItem != null)
                        {
                            <div class="alert @(IsExceeded ? "alert-danger" : IsWarning ? "alert-warning" : "alert-success")">
                                <strong>Protocol Limits Assessment</strong><br />
                                <small>
                                    Current + Usage = Total<br />
                                    Pressure: @SelectedItem.TotalPressureUsed.ToString("F2") + @CheckinModel.MaxPressureObservedBar.ToString("F2") = @CurrentPressure.ToString("F2") / @SelectedItem.MaxAllowedPressureBar bar<br />
                                    Hours: @SelectedItem.TotalRuntimeHours.ToString("F2") + @CheckinModel.RuntimeHours.ToString("F2") = @CurrentHours.ToString("F2") / @SelectedItem.MaxAllowedUsageHours hours<br />
                                    Injections: @SelectedItem.TotalInjections + @CheckinModel.NumberOfInjections = @CurrentInjections / @SelectedItem.MaxAllowedInjections
                                </small>

                                <hr />

                                <strong>Column Safety Check</strong><br />
                                <small>
                                    Column Max Pressure: @SelectedItem.ColumnMaxPressureBar bar<br />
                                    Observed Pressure: @CheckinModel.MaxPressureObservedBar.ToString("F2") bar
                                </small>

                                <div class="mt-2"><strong style="font-size: 1.1rem;">@StatusMessage</strong></div>
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label">Remarks</label>
                            <InputTextArea @bind-Value="CheckinModel.Remarks"
                                           class="form-control"
                                           rows="3"
                                           placeholder="Any observations or notes about column condition" />
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CancelCheckin">
                                Cancel
                            </button>

                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-circle"></i> Complete Check-in
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ColumnCheckoutReadDto> CheckoutList = new();

    private bool IsCheckin;
    private bool IsLoading = true;
    private string? Message;
    private ColumnCheckoutReadDto? SelectedItem;
    private ColumnCheckinDto CheckinModel = new();

    private decimal CurrentPressure;
    private decimal CurrentHours;
    private int CurrentInjections;

    private bool IsExceeded;
    private bool IsWarning;
    private string StatusMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        IsLoading = true;
        Message = null;
        CheckoutList = await UsageService.GetCheckedOutOnlyAsync();
        IsLoading = false;
    }

    private void BeginCheckin(ColumnCheckoutReadDto item)
    {
        SelectedItem = item;
        IsCheckin = true;

        CheckinModel = new ColumnCheckinDto
        {
            CheckoutID = item.CheckoutID,
            CheckinDate = DateTime.UtcNow
        };

        EvaluateLimits();
    }

    private void CancelCheckin()
    {
        IsCheckin = false;
        SelectedItem = null;
        Message = null;
    }

    private void EvaluateLimits()
    {
        if (SelectedItem == null) return;

        CurrentPressure = SelectedItem.TotalPressureUsed + CheckinModel.MaxPressureObservedBar;
        CurrentHours = SelectedItem.TotalRuntimeHours + CheckinModel.RuntimeHours;
        CurrentInjections = SelectedItem.TotalInjections + CheckinModel.NumberOfInjections;

        bool protocolExceeded =
            CurrentPressure > SelectedItem.MaxAllowedPressureBar ||
            CurrentHours > SelectedItem.MaxAllowedUsageHours ||
            CurrentInjections > SelectedItem.MaxAllowedInjections;

        bool columnExceeded =
            CheckinModel.MaxPressureObservedBar > SelectedItem.ColumnMaxPressureBar;

        IsExceeded = protocolExceeded || columnExceeded;

        IsWarning = !IsExceeded &&
            (CurrentPressure > SelectedItem.MaxAllowedPressureBar * 0.8m ||
             CurrentHours > SelectedItem.MaxAllowedUsageHours * 0.8m ||
             CurrentInjections > SelectedItem.MaxAllowedInjections * 0.8m);

        if (columnExceeded)
            StatusMessage = "❌ DAMAGED - Column pressure limit exceeded!";
        else if (protocolExceeded)
            StatusMessage = "❌ EXCEEDED - Protocol limits exceeded!";
        else if (IsWarning)
            StatusMessage = "⚠️ WARNING - Approaching protocol limits (80%)";
        else
            StatusMessage = "✅ SAFE - All limits within range";
    }

    private async Task SaveCheckin()
    {
        EvaluateLimits();

        if (IsExceeded)
        {
            CheckinModel.Status = ColumnStatus.Retired;

            var confirm = await JSRuntime.InvokeAsync<bool>(
                "confirm",
                "Limits exceeded. Column will be marked as RETIRED. Continue?"
            );

            if (!confirm) return;
        }
        else if (IsWarning)
        {
            CheckinModel.Status = ColumnStatus.UnderMaintenance;

            var confirm = await JSRuntime.InvokeAsync<bool>(
                "confirm",
                "Approaching limits. Mark column as UNDER MAINTENANCE for inspection?"
            );

            if (!confirm)
                CheckinModel.Status = ColumnStatus.Available;
        }
        else
        {
            CheckinModel.Status = ColumnStatus.Available;
        }

        var result = await UsageService.CheckinAsync(CheckinModel);

        if (result.Success)
        {
            Message = result.Message ?? "Check-in completed successfully.";
            IsCheckin = false;
            SelectedItem = null;
            await LoadData();
        }
        else
        {
            Message = result.Message ?? "Failed to complete check-in.";
        }
    }

    private string GetDaysOut(DateTime checkoutDate)
    {
        var days = (int)(DateTime.UtcNow - checkoutDate).TotalDays;
        return days == 0 ? "Today" : days == 1 ? "1 day" : $"{days} days";
    }
}
            );

            if (!confirm)
                CheckinModel.Status = ColumnStatus.Available;
        }
        else
        {
            CheckinModel.Status = ColumnStatus.Available;
        }

        var result = await UsageService.CheckinAsync(CheckinModel);

        if (result.Success)
        {
            IsCheckin = false;
            SelectedItem = null;
            await LoadData();
        }
    }
}