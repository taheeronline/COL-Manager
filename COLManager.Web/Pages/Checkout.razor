@page "/checkout"
@using COLManager.Web.DTOs
@using COLManager.Web.Enums
@inject IColumnService ColumnService
@inject IUsageService UsageService
@inject COLManager.Web.Services.IStatusService StatusService
@inject Microsoft.JSInterop.IJSRuntime JS

<h3>Column Checkout</h3>

<button class="btn btn-primary mb-2"
        @onclick="BeginCheckout"
        disabled="@(AvailableColumns == null || !AvailableColumns.Any())">
    <i class="bi bi-plus-circle"></i> New Checkout
</button>

@if (!string.IsNullOrEmpty(Message))
{
    <div class="alert alert-info alert-dismissible fade show mt-3" role="alert">
        @Message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (IsLoading)
{
    <p class="mt-3"><span class="spinner-border spinner-border-sm me-2"></span>Loading checked-out columns...</p>
}
else if (CheckoutList == null || !CheckoutList.Any())
{
    <div class="alert alert-warning mt-3">
        No columns currently checked out. <a href="#" @onclick="BeginCheckout" @onclick:preventDefault>Checkout a column</a>.
    </div>
}
else
{
    <table class="table table-striped table-hover mt-3">
        <thead class="table-dark">
            <tr>
                <th>Column</th>
                <th>Serial Number</th>
                <th>Protocol</th>
                <th>Status</th>
                <th>Checkout Date</th>
                <th>Days Out</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in CheckoutList)
            {
                <tr>
                    <td><strong>@c.ColumnName</strong></td>
                    <td><code>@c.SerialNumber</code></td>
                    <td>@(string.IsNullOrEmpty(c.ProtocolName) || c.ProtocolName == "N/A" ? "-" : c.ProtocolName)</td>
                    <td>
                        <span class="@GetStatusClass(c.Status)">
                            @GetStatusName(c.Status)
                        </span>
                    </td>
                    <td>@c.CheckoutDate.ToString("yyyy-MM-dd")</td>
                    <td>
                        <span class="badge bg-info">@GetDaysOut(c.CheckoutDate)</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (IsCheckout)
{
    <div class="modal show d-block" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog" @onclick:stopPropagation>
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Checkout Column</h5>
                    <button type="button" class="btn-close" @onclick="Cancel"></button>
                </div>

                <div class="modal-body">
                    @if (AvailableColumns == null || !AvailableColumns.Any())
                    {
                        <div class="alert alert-warning">
                            <strong>No columns available for checkout.</strong> All columns are either checked out, under maintenance, or retired.
                        </div>
                    }
                    else
                    {
                        <EditForm Model="CheckoutModel" OnValidSubmit="SaveCheckout">
                            <DataAnnotationsValidator />
                            <ValidationSummary />

                            <div class="mb-3">
                                <label class="form-label">Column <span style="color:red;">*</span></label>
                                <InputSelect @bind-Value="CheckoutModel.ColumnID" class="form-select">
                                    <option value="0">-- Select Column --</option>
                                    @foreach (var col in AvailableColumns)
                                    {
                                        <option value="@col.ColumnID">
                                            @col.ColumnName (@col.SerialNumber)
                                        </option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Remarks</label>
                                <InputTextArea @bind-Value="CheckoutModel.Remarks" class="form-control" rows="3" placeholder="Optional notes about the checkout" />
                            </div>

                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" @onclick="Cancel">
                                    Cancel
                                </button>

                                <button type="submit" class="btn btn-success" disabled="@(CheckoutModel.ColumnID == 0)">
                                    <i class="bi bi-box-seam"></i> Checkout
                                </button>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ColumnCheckoutReadDto> CheckoutList = new();
    private List<ColumnMasterReadDto> Columns = new();
    private List<ColumnMasterReadDto> AvailableColumns = new();
    private IEnumerable<COLManager.Web.Entities.StatusMaster> Statuses = Array.Empty<COLManager.Web.Entities.StatusMaster>();

    private bool IsCheckout = false;
    private bool IsLoading = true;
    private string? Message;

    private ColumnCheckoutCreateDto CheckoutModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        IsLoading = true;
        Message = null;

        var colRes = await ColumnService.GetAllAsync();
        if (colRes.Success)
            Columns = colRes.Data?.ToList() ?? new();

        CheckoutList = await UsageService.GetCheckoutsAsync();

        // Get checked-out column IDs
        var checkedOutIds = CheckoutList
            .Select(x => x.ColumnID)
            .ToHashSet();

        // Only show columns that are NOT checked out, NOT under maintenance, and NOT retired
        AvailableColumns = Columns
            .Where(c => !checkedOutIds.Contains(c.ColumnID) 
                     && c.StatusID != (int)ColumnStatus.UnderMaintenance
                     && c.StatusID != (int)ColumnStatus.Retired)
            .ToList();

        // Load statuses for display
        var statRes = await StatusService.GetAllAsync();
        if (statRes.Success)
            Statuses = statRes.Data ?? Array.Empty<COLManager.Web.Entities.StatusMaster>();

        IsLoading = false;
    }

    private void BeginCheckout()
    {
        if (AvailableColumns == null || !AvailableColumns.Any())
        {
            Message = "No columns available for checkout.";
            return;
        }
        IsCheckout = true;
        CheckoutModel = new ColumnCheckoutCreateDto
        {
            CheckoutDate = DateTime.UtcNow
        };
    }

    private void Cancel()
    {
        IsCheckout = false;
        Message = null;
    }

    private async Task SaveCheckout()
    {
        if (CheckoutModel.ColumnID == 0)
            return;

        var result = await UsageService.CreateCheckoutAsync(CheckoutModel);

        if (result.Success)
        {
            Message = result.Message ?? "Column checked out successfully.";
            IsCheckout = false;
            await LoadData();
        }
        else
        {
            Message = result.Message ?? "Failed to checkout column.";
        }
    }

    private string GetStatusClass(ColumnStatus statusId)
    {
        var status = (ColumnStatus)statusId;

        return status switch
        {
            ColumnStatus.Available => "badge bg-success",
            ColumnStatus.CheckedOut => "badge bg-warning",
            ColumnStatus.UnderMaintenance => "badge bg-warning text-dark",
            ColumnStatus.Retired => "badge bg-danger",
            _ => "badge bg-secondary"
        };
    }

    private string GetStatusName(ColumnStatus statusId)
    {
        var s = Statuses.FirstOrDefault(x => x.StatusID == (int)statusId);
        return s?.StatusName ?? statusId.ToString();
    }

    private string GetDaysOut(DateTime checkoutDate)
    {
        var days = (int)(DateTime.UtcNow - checkoutDate).TotalDays;
        return days == 0 ? "Today" : days == 1 ? "1 day" : $"{days} days";
    }
}